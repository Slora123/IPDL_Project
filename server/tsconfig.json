{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "NodeNext",
    "target": "ESNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ESNext"
    ],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "moduleDetection": "force",
    "baseUrl": ".",
    "paths": {
      "@prisma/client": [
        "node_modules/@prisma/client",
        "node_modules/.prisma/client"
      ]
    }
  },
  "exclude": [
    "prisma.config.ts",
    "check_db.ts",
    "test_endpoint.ts",
    "*.test.ts"
  ]
}