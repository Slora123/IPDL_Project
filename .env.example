# Trackify Server — Copy to server/.env and fill in your keys

# Express server port (default: 3001)
PORT=3001

# SarvamAI API key — for voice/NLP transcription + translation
# Get yours at: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Google Gemini API key — for bill OCR (vision)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
