# Trackify — Environment Variables
# Copy this to .env and fill in your real values.
# NEVER commit .env to git.

# ── Express server ────────────────────────────────────────────────────────────
# Port the Express backend listens on.
# Railway sets this automatically — do not override it on Railway.
PORT=3001

# SQLite database path.
# LOCAL DEV:  leave unset → defaults to ./trackify.db in project root
# RAILWAY:    set to the path inside your persistent volume, e.g.:
#               DB_PATH=/data/trackify.db
DB_PATH=

# CORS allowed origin for the frontend.
# LOCAL DEV:  leave unset → defaults to * (allow all)
# RAILWAY:    set to your Vercel frontend URL, e.g.:
#               ALLOWED_ORIGIN=https://trackify-xyz.vercel.app
ALLOWED_ORIGIN=

# ── API Keys ──────────────────────────────────────────────────────────────────
# SarvamAI — voice/NLP transcription + translation
# Get yours at: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Google Gemini — bill OCR (vision)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Railway backend public URL — used by the Vite frontend in production.
# LOCAL DEV:  leave unset → Vite proxy forwards /api/* to localhost:3001
# VERCEL:     set to your Railway backend URL, e.g.:
#               VITE_API_URL=https://trackify-backend.up.railway.app
VITE_API_URL=
