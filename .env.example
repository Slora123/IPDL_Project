# Trackify — Environment Variables
# Copy this to .env and fill in your real values.
# NEVER commit .env to git. This file contains placeholders only.

# ── Express server (backend) ──────────────────────────────────────────────────

# Port the Express backend listens on.
# Render sets this automatically — never override PORT on Render.
PORT=3001

# JWT secret — used to sign and verify auth tokens.
# LOCAL DEV : any string works
# RENDER    : generate a strong random secret, e.g.:
#               node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING   : changing this invalidates all existing sessions (everyone must re-login)
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# ── Database (Turso — persistent cloud SQLite) ────────────────────────────────
# FREE PLAN FIX: Render's free plan uses ephemeral /tmp storage that resets on
# every restart. Without Turso, all registered users are lost on each restart.
#
# HOW TO SET UP TURSO (free, takes ~2 minutes):
#   1. Go to https://turso.tech and sign up for free
#   2. Install Turso CLI:  curl -sSfL https://get.tur.so/install.sh | bash
#   3. Login:              turso auth login
#   4. Create a DB:        turso db create trackify-db
#   5. Get the URL:        turso db show trackify-db --url
#   6. Get a token:        turso db tokens create trackify-db
#   7. Set these env vars on Render Dashboard → Environment tab:
#        TURSO_DATABASE_URL=libsql://trackify-db-<your-org>.turso.io
#        TURSO_AUTH_TOKEN=<token from step 6>
#
# LOCAL DEV: Leave these UNSET — server uses local ./trackify.db file automatically.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# CORS allowed origin — the URL of your deployed Vercel frontend.
# LOCAL DEV : leave unset → defaults to * (allow all origins)
# RENDER    : set to your exact Vercel URL, e.g.:
#               ALLOWED_ORIGIN=https://ipdltrackify.vercel.app
ALLOWED_ORIGIN=

# SarvamAI API key — voice/NLP transcription and translation
# Get yours at: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Google Gemini API key — bill OCR (vision)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Frontend / Vite (prefix VITE_ so Vite exposes it to the browser) ──────────
# WARNING: VITE_ variables are visible in the browser bundle.
#          Never put backend secrets (API keys) in VITE_ variables.

# Render backend public URL — used by the Vite frontend in production.
# LOCAL DEV : leave unset → Vite dev proxy forwards /api/* to localhost:3001
# VERCEL    : set to your Render service URL, e.g.:
#               VITE_API_URL=https://trackify-backend.onrender.com
VITE_API_URL=
